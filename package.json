{
  "name": "kgwari-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "diagrams": "plantuml -DPLANTUML_SECURITY_PROFILE=INTERNET -tsvg -o ../rendered site-src/diagrams/*.puml",
    "site": "node ./site-src/build.mjs",
    "preview": "node ./scripts/serve-site.mjs",
    "prepare:site": "node ./scripts/prepare-site.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && npm run site && npm run prepare:site",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "hooks:install": "git config core.hooksPath .githooks",
    "version:validate": "node ./scripts/portfolio-version.mjs validate",
    "account:build": "npm run build && node scripts/aws/bootstrap-account.mjs",
    "account:build:dry-run": "npm run build && node scripts/aws/bootstrap-account.mjs --dry-run",
    "cdk:deploy": "npm run build && npx cdk deploy \"kgwari-web/*\" --require-approval never --app \"node dist/infra/cdk/bin/app.js\""
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "aws-cdk": "^2.1106.0",
    "aws-cdk-lib": "^2.179.0",
    "constructs": "^10.3.0",
    "typescript": "^5.6.3"
  }
}

#!/bin/sh
set -eu

remote_name=${1:-origin}

while read -r _local_ref _local_oid remote_ref _remote_oid; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    cat >&2 <<EOF
Direct pushes to main are blocked for $remote_name.

Push a feature branch instead, then merge it through a pull request:
  git push -u $remote_name HEAD
EOF
    exit 1
  fi
done
